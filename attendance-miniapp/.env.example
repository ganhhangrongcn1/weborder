# Không đặt khóa bí mật vào biến VITE_*.
# Chỉ dùng URL backend HTTPS do doanh nghiệp kiểm soát khi thử trên thiết bị Zalo.
# Backend đó cần có xác thực, phân quyền và giới hạn truy cập trước khi được host.
VITE_ATTENDANCE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Chỉ đặt ở môi trường tiến trình Node bridge; không đưa vào frontend.
# Bridge local đọc process.env.ZALO_APP_SECRET, không tự tải file .env này.
ZALO_APP_SECRET=
