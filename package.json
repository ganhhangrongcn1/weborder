{
    "type": "module",
    "scripts": {
        "dev": "node scripts/patch-vite.mjs && vite",
        "build": "node scripts/check-encoding.mjs && node scripts/patch-vite.mjs && vite build --minify esbuild --target es2020",
        "smoke:loyalty": "node scripts/smoke-loyalty-config.mjs",
        "smoke:loyalty-v2": "node scripts/smoke-loyalty-v2-sql.mjs",
        "smoke:vouchers": "node scripts/smoke-checkout-voucher.mjs",
        "smoke:flows": "node scripts/smoke-main-flows.mjs",
        "smoke:success": "node scripts/smoke-order-success-payment.mjs",
        "smoke": "npm run smoke:loyalty && npm run smoke:flows && npm run smoke:supabase-config && npm run smoke:vouchers && npm run smoke:success",
        "fix:encoding": "node scripts/fix-encoding.mjs",
        "check:encoding": "node scripts/check-encoding.mjs",
        "preview": "vite preview",
        "lint": "eslint .",
        "smoke:supabase-config": "node scripts/smoke-supabase-config.mjs",
        "smoke:supabase-core": "node scripts/smoke-supabase-core.mjs",
        "smoke:supabase-catalog": "node scripts/smoke-supabase-catalog.mjs",
        "smoke:supabase-health": "node scripts/smoke-supabase-health.mjs",
        "smoke:customer-profile": "node scripts/smoke-customer-profile-access.mjs",
        "smoke:kitchen": "node scripts/smoke-kitchen-order-items.mjs",
        "smoke:order-spice": "node scripts/smoke-order-spice.mjs",
        "reviews:worker": "node scripts/partner-review-worker.mjs",
        "reviews:worker:once": "node scripts/partner-review-worker.mjs --once",
        "test:partner-review-worker": "node --test scripts/partner-review-login-policy.test.mjs scripts/partner-review-schedule-policy.test.mjs",
        "reviews:worker:install": "powershell -ExecutionPolicy Bypass -File scripts/install-partner-review-worker-task.ps1",
        "reviews:worker:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-partner-review-worker-task.ps1",
        "supabase": "supabase",
        "supabase:login": "supabase login"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@supabase/supabase-js": "^2.105.3",
        "@vitejs/plugin-react": "4.3.4",
        "autoprefixer": "10.4.21",
        "dotenv": "^17.4.2",
        "maplibre-gl": "^5.24.0",
        "postcss": "8.5.6",
        "puppeteer-core": "^25.4.0",
        "qrcode": "1.5.4",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "^6.30.3",
        "tailwindcss": "3.4.17",
        "tough-cookie": "6.0.0",
        "tus-js-client": "^4.3.1",
        "vite": "5.4.19"
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "supabase": "2.109.1"
    }
}
